# Copy this file to .env.local and fill in real values for local development
# outside of Lovable. Never commit .env or .env.local — see .gitignore.
#
# In the Lovable editor these are injected automatically once the project's
# database is enabled; you do not need this file there.

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable ("anon") key. This key is safe to expose in a
# browser bundle — it identifies the project, it does not authorize
# anything by itself. Row Level Security policies are what actually
# protect data. Get it from Project Settings > API in the Supabase
# dashboard. NEVER put a service_role / secret key in a VITE_* variable —
# those are bundled into client-side JavaScript and become public.
VITE_SUPABASE_PUBLISHABLE_KEY=
